<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Il2CppLoader.Views"
        x:Class="Il2CppLoader.Views.MainWindow"
        Width="980" Height="640" MinWidth="820" MinHeight="520"
        Title="Il2CppDumperR Loader"
        Background="#1e1e2e">

  <Grid RowDefinitions="Auto,*,Auto" Margin="14">

    <!-- header -->
    <StackPanel Grid.Row="0" Margin="0,0,0,10">
      <TextBlock Text="Il2CppDumperR" FontSize="24" FontWeight="Bold" Foreground="#89b4fa"/>
      <TextBlock Text="{Binding StatusText}" Foreground="#a6adc8" Margin="0,2,0,0"/>
    </StackPanel>

    <!-- main content -->
    <Grid Grid.Row="1" ColumnDefinitions="340,14,*">

      <!-- process list -->
      <DockPanel Grid.Column="0">
        <TextBlock Text="Running processes" FontWeight="SemiBold" DockPanel.Dock="Top" Margin="0,0,0,6"/>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
          <TextBox Text="{Binding ProcessFilter}" Watermark="filter..." Grid.Column="0"/>
          <Button Content="Refresh" Command="{Binding RefreshProcessesCommand}" Grid.Column="1" Margin="6,0,0,0"/>
        </Grid>
        <ListBox ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedProcess}"
                 Background="#181825" BorderBrush="#313244" BorderThickness="1" CornerRadius="6">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="46,*" Margin="2">
                <Border Grid.Column="0" CornerRadius="4" Padding="4,1" VerticalAlignment="Center"
                        Background="{Binding Kind, Converter={x:Static local:KindBrushConverter.Instance}}">
                  <TextBlock Text="{Binding Kind}" FontSize="10" FontWeight="Bold"
                             HorizontalAlignment="Center" Foreground="#11111b"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                  <TextBlock FontSize="10" Foreground="#6c7086">
                    <TextBlock.Text>
                      <MultiBinding StringFormat="pid {0} — {1}">
                        <Binding Path="Pid"/>
                        <Binding Path="Path"/>
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <!-- right panel -->
      <ScrollViewer Grid.Column="2">
        <StackPanel>

          <!-- game selection -->
          <Border Background="#181825" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <StackPanel>
              <TextBlock Text="Game" FontWeight="SemiBold" Margin="0,0,0,6"/>
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Text="{Binding GamePath}" Watermark="/path/to/Game.exe or Game.x86_64" Grid.Column="0"/>
                <Button Content="Browse..." Command="{Binding BrowseGameCommand}" Grid.Column="1" Margin="6,0,0,0"/>
              </Grid>

              <!-- detection results -->
              <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="0,10,0,0">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Platform:" Foreground="#6c7086"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Game.PlatformName}"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Backend:" Foreground="#6c7086"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Game.BackendName}"
                           FontWeight="Bold"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Unity version:" Foreground="#6c7086"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Game.UnityVersion, TargetNullValue='unknown'}"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Metadata ver:" Foreground="#6c7086"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Game.MetadataVersion}"/>
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Data folder:" Foreground="#6c7086"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Game.DataDir, TargetNullValue='not found'}"
                           TextTrimming="CharacterEllipsis"/>
              </Grid>
            </StackPanel>
          </Border>

          <!-- dumper options -->
          <Border Background="#181825" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <StackPanel>
              <TextBlock Text="Dumper library (leave empty for auto-detect)" FontWeight="SemiBold" Margin="0,0,0,6"/>
              <TextBox Text="{Binding DumperPathOverride}" Watermark="Il2cppDumperR.dll / libIl2cppDumperR.so"/>
            </StackPanel>
          </Border>

          <!-- actions -->
          <WrapPanel Margin="0,0,0,10">
            <Button Content="Inject &amp; Dump" Command="{Binding InjectCommand}"
                    IsEnabled="{Binding CanInject}" Background="#89b4fa" Foreground="#11111b"
                    FontWeight="Bold" Padding="16,8" Margin="0,0,8,8"/>
            <Button Content="Launch with LD_PRELOAD" Command="{Binding LaunchPreloadCommand}"
                    ToolTip.Tip="native Linux games only" Padding="16,8" Margin="0,0,8,8"/>
            <Button Content="Open output folder" Command="{Binding OpenOutputFolderCommand}" Padding="16,8" Margin="0,0,8,8"/>
          </WrapPanel>

          <!-- log -->
          <Border Background="#11111b" CornerRadius="8" Padding="10" MinHeight="180">
            <StackPanel>
              <TextBlock Text="Log" FontWeight="SemiBold" Margin="0,0,0,6"/>
              <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="300">
                <SelectableTextBlock Text="{Binding LogText}" FontFamily="Monospace" FontSize="11"
                                     Foreground="#a6e3a1" TextWrapping="Wrap"/>
              </ScrollViewer>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- footer -->
    <TextBlock Grid.Row="2" Margin="0,10,0,0" FontSize="11" Foreground="#6c7086"
               Text="output: il2cpp_classes.json + il2cpp_strings.json in the game folder — import into IDA with ida/il2cpp_import.py"/>
  </Grid>
</Window>
